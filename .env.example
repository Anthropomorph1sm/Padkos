# Copy to .env (or export) to override defaults. Everything is optional.
PORT=8787
DB_PATH=./data/padkos.db

# Routing (OSRM). The public demo server is fine for personal use; self-host for anything bigger.
OSRM_URL=https://router.project-osrm.org
OSRM_MAX_TABLE=100
OSRM_MAX_WAYPOINTS=50

# Geocoding and map data (OpenStreetMap services)
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM services ask apps to identify themselves; put your site URL or contact here.
APP_USER_AGENT=PadkosRoadTripPlanner/1.0 (self-hosted)

# Live traffic incidents and road works (optional): https://developer.tomtom.com
TOMTOM_API_KEY=

# Which proxies may set X-Forwarded-For. Behind nginx on the host with the app in Docker, use
# "loopback,uniquelocal" so rate limits see the real client IP.
# TRUST_PROXY=loopback

# Privacy radius (m) removed around start/end on shared routes
PRIVACY_RADIUS_M=5000

# Client build-time: map tiles (defaults to tile.openstreetmap.org)
# VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
